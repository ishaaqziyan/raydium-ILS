---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Raydium IL Simulator">
  <main class="mx-auto flex h-screen max-w-4xl flex-col gap-1.5 overflow-hidden px-3 py-2 sm:gap-3 sm:px-6 sm:py-4">
    <div class="relative shrink-0 flex flex-col gap-0.5 sm:gap-2">
      <div class="flex flex-col items-center gap-0.5 self-end lg:absolute lg:right-0 lg:top-0 lg:flex-row lg:gap-2">
        <span class="text-[9px] uppercase tracking-wide text-slate-500 sm:text-[10px]">Powered by</span>
        <div class="flex items-center gap-1.5 rounded-full border border-slate-800 bg-slate-900 py-0.5 pl-2 pr-1.5 sm:gap-2 sm:py-1 sm:pl-3 sm:pr-2">
          <span class="relative flex h-1.5 w-1.5 sm:h-2 sm:w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-emerald-500 sm:h-2 sm:w-2"></span>
          </span>
          <img src="/brand/helius-horizontal-logo.png" alt="Helius" class="h-3 w-auto sm:h-4" />
        </div>
      </div>

      <header class="flex flex-col items-center gap-0.5 text-center">
        <h1 class="text-base font-semibold tracking-tight text-white sm:text-2xl">Raydium Impermanent Loss Simulator</h1>
        <p class="text-xs text-slate-200 sm:text-base">
          Real historical reserve and price data for a Raydium pool, replayed snapshot by snapshot:
          not a theoretical IL curve.
        </p>
      </header>
    </div>

    <section class="shrink-0 flex flex-wrap items-end gap-2 rounded-lg border border-slate-800 bg-slate-900/60 p-2 sm:gap-4 sm:p-4">
      <label class="flex flex-col gap-0.5 text-xs text-slate-300 sm:gap-1 sm:text-sm">
        Pool
        <select
          id="pool-select"
          class="rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-sm text-slate-100 focus:border-sky-500 focus:outline-none sm:px-3 sm:py-2 sm:text-base"
        >
        </select>
      </label>

      <label class="flex flex-col gap-0.5 text-xs text-slate-300 sm:gap-1 sm:text-sm">
        Range
        <select
          id="range-select"
          class="rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-sm text-slate-100 focus:border-sky-500 focus:outline-none sm:px-3 sm:py-2 sm:text-base"
        >
          <option value="7">7 days</option>
          <option value="30" selected>30 days</option>
          <option value="90">90 days</option>
        </select>
      </label>

      <label class="flex flex-col gap-0.5 text-xs text-slate-300 sm:gap-1 sm:text-sm">
        Deposit (USD)
        <input
          id="deposit-input"
          type="number"
          min="1"
          step="100"
          value="10000"
          class="w-28 rounded-md border border-slate-700 bg-slate-950 px-2 py-1 text-sm text-slate-100 focus:border-sky-500 focus:outline-none sm:w-32 sm:px-3 sm:py-2 sm:text-base"
        />
      </label>

      <button
        id="run-button"
        class="flex w-full items-center justify-center gap-2 rounded-md bg-sky-500 px-4 py-2 min-h-[36px] text-sm font-semibold text-slate-950 transition hover:bg-sky-400 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto sm:min-h-[44px]"
      >
        <svg id="run-spinner" class="hidden h-4 w-4 animate-spin text-slate-950" viewBox="0 0 24 24" fill="none">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
        </svg>
        <span id="run-button-label">Run simulation</span>
      </button>

      <span id="status-line" class="text-[11px] text-slate-400 transition-opacity duration-300 sm:text-sm"></span>
    </section>

    <section class="relative flex min-h-[90px] flex-1 flex-col rounded-lg border border-slate-800 bg-slate-900/60 p-2 sm:min-h-[220px] sm:p-4">
      <div class="relative min-h-0 w-full flex-1">
        <canvas
          id="il-chart"
          class="opacity-0 transition-opacity duration-500 ease-out"
        ></canvas>

        <div
          id="chart-loading"
          class="pointer-events-none absolute inset-0 flex flex-col items-center justify-center gap-3 opacity-100 transition-opacity duration-300"
        >
          <svg class="h-8 w-8 animate-spin text-sky-500" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-20" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-90" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
          </svg>
          <p class="animate-pulse text-sm text-slate-500">Replaying on-chain history…</p>
        </div>
      </div>
    </section>

    <section
      id="summary-panel"
      class="flex shrink-0 translate-y-2 flex-col gap-0.5 rounded-lg border border-slate-800 bg-slate-900/60 p-2 opacity-0 transition-all duration-500 ease-out sm:gap-2 sm:p-4"
    >
      <p id="summary-headline" class="text-xs font-semibold text-white sm:text-lg"></p>
      <p id="summary-detail" class="text-xs text-slate-400 tabular-nums sm:text-sm"></p>
    </section>

    <footer class="shrink-0 text-center text-xs text-slate-300">
      Powered by <a
        href="https://ishaaq.org"
        target="_blank"
        rel="noopener noreferrer"
        class="text-slate-200 underline decoration-slate-600 underline-offset-2 hover:text-sky-400"
      >ishaaq.org</a>
    </footer>
  </main>

  <script>
    import { fetchIlSeries, type IlSeriesResponse } from "../lib/api";
    import { populatePoolSelect } from "../lib/poolSelector";
    import { renderIlChart } from "../lib/chart";

    const poolSelect = document.getElementById("pool-select") as HTMLSelectElement;
    const rangeSelect = document.getElementById("range-select") as HTMLSelectElement;
    const depositInput = document.getElementById("deposit-input") as HTMLInputElement;
    const runButton = document.getElementById("run-button") as HTMLButtonElement;
    const runSpinner = document.getElementById("run-spinner") as HTMLElement;
    const runButtonLabel = document.getElementById("run-button-label") as HTMLSpanElement;
    const statusLine = document.getElementById("status-line") as HTMLSpanElement;
    const chartCanvas = document.getElementById("il-chart") as HTMLCanvasElement;
    const chartLoading = document.getElementById("chart-loading") as HTMLDivElement;
    const summaryPanel = document.getElementById("summary-panel") as HTMLElement;
    const summaryHeadline = document.getElementById("summary-headline") as HTMLParagraphElement;
    const summaryDetail = document.getElementById("summary-detail") as HTMLParagraphElement;

    populatePoolSelect(poolSelect);

    function setStatus(text: string) {
      statusLine.classList.add("opacity-0");
      window.setTimeout(() => {
        statusLine.textContent = text;
        statusLine.classList.remove("opacity-0");
      }, 150);
    }

    function setLoading(loading: boolean) {
      runButton.disabled = loading;
      runSpinner.classList.toggle("hidden", !loading);
      runButtonLabel.textContent = loading ? "Loading…" : "Run simulation";
      chartLoading.classList.toggle("opacity-100", loading);
      chartLoading.classList.toggle("opacity-0", !loading);
      chartCanvas.classList.toggle("opacity-0", loading);
      chartCanvas.classList.toggle("opacity-100", !loading);
    }

    function renderSummary(data: IlSeriesResponse) {
      const last = data.points.at(-1);
      if (!last) return;

      const direction = last.ilPercent < 0 ? "lost" : "gained";
      const magnitude = Math.abs(last.ilPercent).toFixed(3);

      summaryHeadline.textContent = `Providing liquidity ${direction} ${magnitude}% versus holding.`;
      summaryDetail.textContent =
        `${data.poolLabel} · entry price ${data.entryPrice.toFixed(2)} · ` +
        `$${data.depositUsd.toLocaleString()} starting deposit · ` +
        `hold $${last.holdValue.toFixed(2)} vs LP $${last.lpValue.toFixed(2)} today.`;

      summaryPanel.classList.remove("opacity-0", "translate-y-2");
    }

    async function run() {
      const poolId = poolSelect.value;
      const days = Number(rangeSelect.value) as 7 | 30 | 90;
      const depositUsd = Number(depositInput.value);

      if (!Number.isFinite(depositUsd) || depositUsd <= 0) {
        setStatus("Deposit must be a positive number.");
        return;
      }

      setLoading(true);
      summaryPanel.classList.add("opacity-0", "translate-y-2");
      setStatus("Fetching real on-chain history from Helius: first run for a range can take a few minutes…");

      try {
        const data = await fetchIlSeries(poolId, days, depositUsd);
        renderIlChart(chartCanvas, data.points);
        renderSummary(data);
        setStatus(`Loaded ${data.points.length} snapshots.`);
      } catch (err) {
        setStatus(err instanceof Error ? err.message : "Failed to load IL series.");
      } finally {
        setLoading(false);
      }
    }

    function debounce(fn: () => void, delayMs: number) {
      let timer: ReturnType<typeof setTimeout> | undefined;
      return () => {
        clearTimeout(timer);
        timer = setTimeout(fn, delayMs);
      };
    }

    const debouncedRun = debounce(run, 400);

    runButton.addEventListener("click", run);
    depositInput.addEventListener("input", debouncedRun);
    run();
  </script>
</BaseLayout>
